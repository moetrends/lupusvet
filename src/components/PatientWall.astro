---
// Muayene masamızdan geçen gerçek hastalarımız. Fotoğraflar panelden (Sayfalar → Hasta duvarı) yönetilir.
import { Image } from 'astro:assets';
import { pageData } from '../lib/pages';
const { photos } = await pageData('hastaDuvari');
const tilt = [-2.2, 1.4, -1, 2, 0.4, -1.6, 1.1, -0.6];
// Düzensiz gecikmeler: el ile dağıtılmış hissi, makine gibi değil.
const delay = [0, 90, 40, 150, 70, 200, 120, 30, 180, 60, 140, 100];
---
<ul class="columns-2 gap-4 sm:columns-3 lg:columns-4 [&>li]:mb-4">
  {photos.map((p, i) => (
    <li class="polaroid break-inside-avoid rounded-[6px] bg-white p-2 pb-3 shadow-[0_1px_2px_rgba(25,34,61,.12),0_8px_24px_-12px_rgba(25,34,61,.25)]" style={`--r:${tilt[i % tilt.length]}deg;--d:${delay[i % delay.length]}ms`}>
      <Image src={p.image} alt={p.alt} widths={[280, 420]} sizes="(min-width: 1024px) 260px, (min-width: 640px) 30vw, 45vw" class="w-full rounded-[3px]" loading="lazy" />
    </li>
  ))}
</ul>
