---
import { clinic } from '../data/clinic';
interface Props { dark?: boolean; compact?: boolean }
const { dark = false, compact = false } = Astro.props;
const short: Record<string, string> = { 'Pazartesi – Cumartesi': 'Pzt – Cmt', 'Pazartesi – Cuma': 'Pzt – Cum', Pazar: 'Pazar' };
---
<table class="w-full max-w-sm text-left">
  <tbody>
    {clinic.hours.map((h) => (
      <tr class:list={['border-b', dark ? 'border-white/10' : 'border-line']}>
        <th scope="row" class="py-2 pr-4 font-normal">{compact ? <abbr title={h.label} class="no-underline">{short[h.label] ?? h.label}</abbr> : h.label}</th>
        <td class="whitespace-nowrap py-2 text-right font-bold tabular-nums">{h.opens} – {h.closes}</td>
      </tr>
    ))}
  </tbody>
</table>
<p class:list={['mt-2 text-[.95rem]', dark ? 'text-white/65' : 'text-muted']} data-open-status data-hours={JSON.stringify(clinic.hours.map((h) => ({ d: h.days, o: h.opens, c: h.closes })))}></p>
<script>
  // Klinik şu an açık mı? (Türkiye saati, UTC+3)
  const el = document.querySelectorAll<HTMLElement>('[data-open-status]');
  const names = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Istanbul' }));
  const mins = now.getHours() * 60 + now.getMinutes();
  const toMin = (t: string) => +t.slice(0, 2) * 60 + +t.slice(3);
  const hours: { d: string[]; o: string; c: string }[] = JSON.parse(el[0]?.dataset.hours ?? '[]');
  const today = hours.find((h) => h.d.includes(names[now.getDay()]));
  const open = !!today && mins >= toMin(today.o) && mins < toMin(today.c);
  const text = open ? `Şu an açık, kapanış ${today!.c}` : 'Şu an kapalı';
  el.forEach((e) => { e.innerHTML = `<span class="status-dot" aria-hidden="true"></span>${text}`; e.dataset.state = open ? 'open' : 'closed'; });
</script>
