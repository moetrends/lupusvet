---
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Konum" class="wrap pt-6 text-[.95rem] text-muted">
  <ol class="flex flex-wrap items-center gap-x-2">
    <li><a href="/" class="link">Ana sayfa</a></li>
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {i === items.length - 1 ? <span aria-current="page" class="text-ink">{it.name}</span> : <a href={it.url} class="link">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
