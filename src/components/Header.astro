---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.jpg';
import { clinic, telHref } from '../data/clinic';

const nav = [
  { href: '/hizmetler', label: 'Hizmetler' },
  { href: '/veteriner-hekim-yunus-kurt', label: 'Hekimimiz' },
  { href: '/hakkimizda', label: 'Klinik' },
  { href: '/blog', label: 'Blog' },
  { href: '/yorumlar', label: 'Yorumlar' },
  { href: '/iletisim', label: 'İletişim' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/92 backdrop-blur-md">
  <div class="wrap flex h-[4.5rem] items-center gap-4">
    <a href="/" class="flex shrink-0 items-center gap-3 no-underline" aria-label={`${clinic.name} ana sayfa`}>
      <Image src={logo} alt="" width={52} height={52} class="size-[52px] rounded-full" loading="eager" />
      <span class="leading-tight">
        <span class="block font-serif text-[1.3rem] font-semibold text-navy-deep">Lupus</span>
        <span class="block text-[.82rem] text-muted">Veteriner Kliniği, Çukurova</span>
      </span>
    </a>

    <nav aria-label="Ana menü" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((n) => (
          <li>
            <a href={n.href} class:list={['rounded-full px-3 py-2 text-[1.02rem] no-underline transition-colors hover:bg-mist', isActive(n.href) ? 'font-bold text-navy' : 'text-ink']} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-3">
      <a href={telHref} class="hidden whitespace-nowrap font-bold text-navy no-underline sm:inline lg:hidden xl:inline">{clinic.phone}</a>
      <a href={clinic.bookingUrl} target="_blank" rel="noopener" class="btn btn-red hidden whitespace-nowrap !py-2 md:inline-flex">Randevu al</a>
      <details class="group relative lg:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full hover:bg-mist [&::-webkit-details-marker]:hidden" aria-label="Menüyü aç">
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="group-open:hidden"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" class="hidden group-open:block"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </summary>
        <nav aria-label="Mobil menü" class="absolute right-0 mt-2 w-64 rounded-2xl border border-line bg-white p-2 shadow-xl">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} class:list={['block rounded-xl px-4 py-3 no-underline hover:bg-mist', isActive(n.href) && 'font-bold text-navy']}>{n.label}</a></li>
            ))}
            <li><a href="/randevu" class="block rounded-xl px-4 py-3 font-bold text-red no-underline hover:bg-mist">Randevu al</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
