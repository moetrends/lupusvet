---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PatientWall from '../components/PatientWall.astro';
import ReviewList from '../components/ReviewList.astro';
import HoursTable from '../components/HoursTable.astro';
import MapEmbed from '../components/MapEmbed.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { clinic, fullAddress, telHref } from '../data/clinic';
import { personSchema } from '../lib/schema';
import hero from '../assets/photos/yunus-kurt-kedi-yavrusu.jpg';
import vetPhoto from '../assets/photos/yunus-kurt-golden.jpg';
import clinicPhoto from '../assets/photos/klinik-ic-resepsiyon.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const years = new Date().getFullYear() - clinic.founded;
---
<Base
  title="Lupus Veteriner Kliniği | Çukurova, Adana Veteriner Hekim Yunus Kurt"
  description="Çukurova Mavi Bulvar'da kedi ve köpekler için muayene, cerrahi, ortopedi, ultrason, röntgen ve laboratuvar. Veteriner Hekim Yunus Kurt. Randevu: 0537 211 50 05."
  image={hero}
  schema={[personSchema()]}
>
  <!-- Hero: tam genişlik, lacivert panel + kenara taşan fotoğraf -->
  <section class="relative overflow-hidden bg-navy-deep text-white">
    <div class="grid md:min-h-[min(84vh,720px)] md:grid-cols-[1.05fr_1fr]">
      <div class="relative order-2 flex items-center px-4 pt-10 pb-24 md:order-1 md:py-20 md:pr-12 md:pl-[max(1rem,calc((100vw-72rem)/2))]">
        <div class="max-w-[34rem]">
          <h1 class="hero-line !text-white" style="--i:0">Çukurova’da kedi ve köpeklerin hekimi, {clinic.founded}’dan beri.</h1>
          <p class="hero-line mt-6 text-[1.22rem] leading-relaxed text-white/75" style="--i:1">
            Mavi Bulvar’daki kliniğimizde muayene, cerrahi, görüntüleme ve laboratuvar aynı çatı altında. Dostunuzla Veteriner Hekim Yunus Kurt ve ekibi ilgileniyor.
          </p>
          <div class="hero-line mt-8 flex flex-wrap gap-3" style="--i:2">
            <a href={clinic.bookingUrl} target="_blank" rel="noopener" class="btn btn-red">Randevu al</a>
            <a href={telHref} class="btn btn-line text-white">Ara: {clinic.phone}</a>
          </div>
          <dl class="hero-line mt-12 grid grid-cols-3 divide-x divide-white/15 border-t border-white/15 pt-6" style="--i:3">
            <div class="pr-4">
              <dt class="text-[.9rem] text-white/55">Google puanı</dt>
              <dd class="mt-1 font-serif text-[1.9rem] leading-none font-semibold">{clinic.rating.value.toLocaleString('tr-TR')}<span class="ml-1 text-[1rem] text-white/55">/ 5</span></dd>
              <dd class="mt-1 text-[.9rem] text-white/55"><a href="/yorumlar" class="link">{clinic.rating.count} yorum</a></dd>
            </div>
            <div class="px-4">
              <dt class="text-[.9rem] text-white/55">Kuruluş</dt>
              <dd class="mt-1 font-serif text-[1.9rem] leading-none font-semibold">{clinic.founded}</dd>
              <dd class="mt-1 text-[.9rem] text-white/55">Mavi Bulvar</dd>
            </div>
            <div class="pl-4">
              <dt class="text-[.9rem] text-white/55">Klinik içinde</dt>
              <dd class="mt-1 text-[1.02rem] leading-snug">Röntgen, ultrason, laboratuvar</dd>
            </div>
          </dl>
        </div>
      </div>
      <figure class="relative order-1 md:order-2">
        <Image src={hero} alt="Veteriner Hekim Yunus Kurt kucağında bir kedi yavrusuyla" widths={[480, 720, 960, 1200]} sizes="(min-width: 768px) 48vw, 100vw" loading="eager" fetchpriority="high" class="hero-photo aspect-[4/3.4] h-full w-full object-cover object-[50%_25%] md:absolute md:inset-0 md:aspect-auto" />
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-deep/70 via-transparent to-transparent md:bg-gradient-to-r md:from-navy-deep/60 md:via-transparent"></div>
        <figcaption class="hero-tag absolute bottom-5 right-5 md:bottom-24 rounded-full bg-white/95 px-4 py-2 text-[.95rem] text-navy-deep shadow-md">Vet. Hek. Yunus Kurt</figcaption>
      </figure>
    </div>
  </section>

  <!-- Bilgi kartı: hero'nun üstüne biner -->
  <section aria-label="Adres ve saatler" class="wrap relative z-10 -mt-14">
    <div class="grid gap-8 rounded-[24px] bg-white p-6 shadow-[0_1px_2px_rgba(20,32,74,.06),0_24px_48px_-24px_rgba(20,32,74,.35)] ring-1 ring-line/70 md:grid-cols-3 md:gap-0 md:divide-x md:divide-line md:p-8">
      <div class="flex gap-4 md:pr-8">
        <span class="icon-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-5" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
        <div>
          <h2 class="!text-[1.15rem]">Adres</h2>
          <p class="mt-1.5 text-[1.02rem] leading-snug">{fullAddress}</p>
          <a href={clinic.directionsUrl} target="_blank" rel="noopener" class="link mt-2 inline-block font-bold text-navy">Yol tarifi al</a>
        </div>
      </div>
      <div class="flex gap-4 md:px-8">
        <span class="icon-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" class="size-5" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg></span>
        <div class="flex-1">
          <h2 class="!text-[1.15rem]">Çalışma saatleri</h2>
          <div class="mt-0.5 text-[1.02rem]"><HoursTable compact /></div>
        </div>
      </div>
      <div class="flex gap-4 md:pl-8">
        <span class="icon-ring"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" class="size-5" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
        <div>
          <h2 class="!text-[1.15rem]">Telefon ve WhatsApp</h2>
          <p class="mt-1.5"><a href={telHref} class="text-[1.6rem] font-bold text-navy-deep no-underline">{clinic.phone}</a></p>
          <a href={clinic.whatsapp} target="_blank" rel="noopener" class="link mt-1 inline-block font-bold text-navy">WhatsApp’tan yazın</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hizmetler: çerçeveli ızgara -->
  <section class="wrap mt-24" aria-labelledby="hizmetler-baslik">
    <div class="mb-10 grid gap-4 md:grid-cols-[1fr_1fr] md:items-end">
      <h2 id="hizmetler-baslik">Hizmetlerimiz</h2>
      <p class="max-w-xl text-ink/75 md:justify-self-end">Koruyucu muayeneden ortopedik cerrahiye kadar. Tahlil ve görüntülemenin çoğu klinik içinde, aynı gün yapılıyor.</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-[24px] bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => (
        <li class="bg-white">
          <a href={`/hizmetler/${s.id}`} class="group flex h-full flex-col p-6 no-underline transition-colors duration-200 hover:bg-mist/60">
            <span class="icon-ring transition-colors duration-200 group-hover:border-navy group-hover:bg-navy group-hover:text-white"><ServiceIcon slug={s.id} class="size-[22px]" /></span>
            <span class="mt-5 font-serif text-[1.3rem] leading-tight font-semibold text-navy-deep">{s.data.title}</span>
            <span class="mt-2 text-[.97rem] leading-snug text-muted">{s.data.includes.slice(0, 3).join(', ')}</span>
          </a>
        </li>
      ))}
      <li class="bg-navy">
        <a href="/hizmetler" class="group flex h-full flex-col justify-between p-6 text-white no-underline transition-colors duration-200 hover:bg-navy-deep">
          <span class="font-serif text-[1.3rem] leading-tight font-semibold">Tüm hizmetler ve rutin işlemler</span>
          <span class="mt-6 text-white/70">Aşı, parazit, mikroçip, tırnak kesimi ve daha fazlası</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Hekim -->
  <section class="relative mt-24 overflow-hidden bg-navy-deep py-20 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-[28rem] rounded-full bg-navy opacity-60"></div>
    <div class="wrap relative grid items-center gap-10 md:grid-cols-[1fr_1.15fr] md:gap-16">
      <div data-reveal class="overflow-hidden rounded-[28px]"><Image src={vetPhoto} alt="Veteriner Hekim Yunus Kurt bir köpekle klinikte" widths={[480, 720]} sizes="(min-width: 768px) 42vw, 100vw" class="aspect-[4/5] w-full rounded-[28px] object-cover" loading="lazy" /></div>
      <div>
        <p class="text-[1.05rem] text-[#a9bbdf]">Kurucu hekim</p>
        <h2 class="mt-2 !text-white">Veteriner Hekim Yunus Kurt</h2>
        <p class="measure mt-5 text-[1.2rem] leading-relaxed text-white/80">
          Lupus’u {clinic.founded}’da Mavi Bulvar’da kurdu. {years} yıldır Çukurova’daki kedi ve köpeklerin aşısından ameliyatına kadar her aşamasında yanlarında.
          Hasta sahiplerimizin yorumlarında en çok geçen kelimeler “ilgili” ve “vicdanlı”.
        </p>
        <a href="/veteriner-hekim-yunus-kurt" class="btn btn-line mt-7 text-white">Hekimimizi tanıyın</a>
      </div>
    </div>
  </section>

  <!-- Hasta duvarı -->
  <section class="bg-mist py-20" aria-labelledby="dostlar-baslik">
    <div class="wrap">
    <div class="mb-10 max-w-2xl">
      <h2 id="dostlar-baslik">Muayene masamızdan geçenler</h2>
      <p class="mt-4 text-ink/80">Hepsi gerçek hastalarımız. Daha fazlası ve vaka hikâyeleri <a href={clinic.instagramUrl} target="_blank" rel="noopener" class="link font-bold text-navy">Instagram hesabımızda</a>.</p>
    </div>
    <PatientWall />
    </div>
  </section>

  <!-- Yorumlar -->
  <section class="bg-navy py-20 text-white" aria-labelledby="yorum-baslik">
    <div class="wrap">
      <h2 id="yorum-baslik" class="mb-12 !text-white">Hasta sahiplerimiz ne diyor?</h2>
      <ReviewList limit={3} dark />
    </div>
  </section>

  <!-- Blog -->
  {posts.length > 0 && (
    <section class="wrap mt-24" aria-labelledby="blog-baslik">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 id="blog-baslik">Blogdan</h2>
        <a href="/blog" class="link font-bold text-navy">Tüm yazılar</a>
      </div>
      <ul class="grid gap-10 md:grid-cols-3">
        {posts.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={`/blog/${p.id}`} class="card group block no-underline">
              <div class="zoom rounded-[20px]"><Image src={p.data.hero} alt={p.data.heroAlt} widths={[400, 640]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="lazy" /></div>
              <p class="mt-4 text-[.95rem] text-muted">{p.data.category === 'vaka' ? 'Vaka' : 'Bilgi'}</p>
              <h3 class="mt-1 group-hover:text-red">{p.data.title}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Konum -->
  <section class="wrap mt-24 grid gap-10 md:grid-cols-[1fr_1.4fr]" aria-labelledby="konum-baslik">
    <div>
      <h2 id="konum-baslik">Bizi nasıl bulursunuz?</h2>
      <p class="mt-4">{fullAddress}</p>
      <p class="mt-2 text-muted">{clinic.address.landmark}.</p>
      <Image data-reveal src={clinicPhoto} alt="Lupus Veteriner Kliniği resepsiyon ve bekleme alanı" widths={[400, 640]} sizes="(min-width: 768px) 35vw, 100vw" class="mt-6 aspect-[4/3] w-full rounded-[20px] object-cover" loading="lazy" />
    </div>
    <MapEmbed />
  </section>

  <CtaBand />
</Base>
