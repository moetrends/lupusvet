---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PatientWall from '../components/PatientWall.astro';
import CtaBand from '../components/CtaBand.astro';
import { clinic, fullAddress } from '../data/clinic';
import { pageData, paragraphs } from '../lib/pages';

const page = await pageData('hakkimizda');
---
<Base
  title={page.seo.title}
  description={page.seo.description}
  image={page.image}
  breadcrumbs={[{ name: 'Kliniğimiz', url: '/hakkimizda' }]}
>
  <section class="wrap grid items-center gap-10 pt-8 md:grid-cols-[1.1fr_1fr]">
    <div>
      <h1 class="hero-line">{page.title}</h1>
      <div class="prose-lupus measure mt-6">
        {paragraphs(page.body).map((p) => <p>{p}</p>)}
      </div>
    </div>
    <Image src={page.image} alt={page.imageAlt} widths={[480, 768]} sizes="(min-width: 768px) 45vw, 100vw" loading="eager" class="hero-photo aspect-[4/5] w-full rounded-[32px] object-cover" />
  </section>

  <section class="wrap mt-24">
    <div class="mb-10 grid gap-4 md:grid-cols-2 md:items-end">
      <h2>{page.equipmentTitle}</h2>
      <p class="max-w-xl text-ink/75 md:justify-self-end">{page.equipmentIntro}</p>
    </div>
    <ul class="grid gap-10 md:grid-cols-3">
      {page.highlights.map((e, i) => (
        <li data-reveal style={`--i:${i}`}>
          <div class="zoom rounded-[20px]"><Image src={e.image} alt={e.alt} widths={[400, 640]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[4/3] w-full object-cover object-[50%_30%]" loading="lazy" /></div>
          <h3 class="mt-4">{e.title}</h3>
          <p class="mt-1 text-ink/80">{e.text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-14 grid items-start gap-10 md:grid-cols-[1fr_1.2fr]">
      <Image src={page.roomImage} alt={page.roomImageAlt} widths={[480, 768]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[4/3] w-full rounded-[24px] object-cover" loading="lazy" />
      <table class="w-full text-left">
        <caption class="sr-only">Klinikteki cihazlar</caption>
        <tbody class="divide-y divide-line border-y border-line">
          {clinic.equipment.map((e) => (
            <tr>
              <th scope="row" class="py-4 pr-6 align-top font-serif text-[1.15rem] font-semibold text-navy-deep">{e.name}</th>
              <td class="py-4 align-top text-muted">{e.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-24 bg-mist py-20">
    <div class="wrap">
      <h2 class="mb-10">Muayene masamızdan geçenler</h2>
      <PatientWall />
    </div>
  </section>

  <section class="wrap mt-20">
    <h2>Adres</h2>
    <p class="mt-3">{fullAddress}. {clinic.address.landmark}.</p>
    <a href="/iletisim" class="link mt-2 inline-block font-bold text-navy">İletişim ve harita</a>
  </section>

  <CtaBand />
</Base>
