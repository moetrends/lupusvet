---
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { clinic } from '../../data/clinic';
import { blogPostingSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { Content } = await render(entry);
const service = entry.data.service ? await getEntry('services', entry.data.service) : undefined;
const heroImg = await getImage({ src: entry.data.hero, width: 1200, format: 'jpg' });
const date = entry.data.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.hero}
  type="article"
  breadcrumbs={[{ name: 'Blog', url: '/blog' }, { name: entry.data.title, url: `/blog/${entry.id}` }]}
  schema={[blogPostingSchema({ title: entry.data.title, description: entry.data.description, date: entry.data.date, slug: entry.id, image: heroImg.src })]}
>
  <article class="wrap pt-8">
    <header class="max-w-3xl">
      <p class="text-muted">{entry.data.category === 'vaka' ? 'Vaka hikâyesi' : 'Bilgi'}, {date}</p>
      <h1 class="mt-3">{entry.data.title}</h1>
      <p class="mt-5 text-[1.2rem] text-ink/85">{entry.data.description}</p>
      <p class="mt-5 text-[1rem]">Yazan: <a href="/veteriner-hekim-yunus-kurt" class="link font-bold text-navy">Vet. Hek. Yunus Kurt</a></p>
    </header>

    <div class="mt-10 grid gap-14 lg:grid-cols-[1fr_18rem]">
      <div>
        <Image src={entry.data.hero} alt={entry.data.heroAlt} widths={[480, 800, 1100]} sizes="(min-width: 1024px) 680px, 100vw" loading="eager" class="max-h-[34rem] w-full rounded-[24px] object-cover" />
        <div class="prose-lupus measure mt-10">
          <Content />
        </div>
        {entry.data.source && (
          <p class="measure mt-10 text-[1rem] text-muted">Bu vakanın videosu: <a href={entry.data.source} target="_blank" rel="noopener" class="link text-navy">Instagram’da izleyin</a>.</p>
        )}
        <p class="measure mt-6 rounded-2xl bg-mist p-5 text-[1rem]">Bu yazı genel bilgilendirme amaçlıdır ve muayenenin yerini tutmaz. Dostunuzda benzer belirtiler varsa <a href={`tel:${clinic.phoneE164}`} class="link font-bold text-navy">{clinic.phone}</a> numarasından bize ulaşın.</p>
      </div>
      <aside class="space-y-8 lg:sticky lg:top-28 lg:self-start">
        {service && (
          <div class="rounded-[22px] bg-white p-6 ring-1 ring-line">
            <p class="text-muted">İlgili hizmet</p>
            <a href={`/hizmetler/${service.id}`} class="mt-1 block font-serif text-2xl font-semibold text-navy-deep no-underline hover:text-red">{service.data.title}</a>
            <p class="mt-2 text-[1rem] text-ink/80">{service.data.short}</p>
          </div>
        )}
        <a href={clinic.bookingUrl} target="_blank" rel="noopener" class="btn btn-red w-full justify-center">Randevu al</a>
      </aside>
    </div>
  </article>
  <CtaBand />
</Base>
