---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { clinic } from '../../data/clinic';
import { serviceSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'services'> };
const { Content } = await render(entry);
const all = await getCollection('services');
const related = entry.data.related.map((id) => all.find((s) => s.id === id)).filter(Boolean) as CollectionEntry<'services'>[];
const posts = (await getCollection('blog')).filter((p) => p.data.service === entry.id);
---
<Base
  title={entry.data.seoTitle}
  description={entry.data.short}
  image={entry.data.hero}
  breadcrumbs={[{ name: 'Hizmetler', url: '/hizmetler' }, { name: entry.data.title, url: `/hizmetler/${entry.id}` }]}
  schema={[serviceSchema({ title: entry.data.title, short: entry.data.short, slug: entry.id }), faqSchema(entry.data.faq)]}
>
  <article>
    <header class="wrap grid items-end gap-10 pt-8 md:grid-cols-[1.1fr_1fr]">
      <div>
        <span class="hero-line icon-chip mb-5 bg-leaf-soft text-leaf"><ServiceIcon slug={entry.id} class="size-6" /></span>
        <h1 class="hero-line">{entry.data.title}</h1>
        <p class="hero-line measure mt-5 text-[1.2rem] text-ink/85">{entry.data.short}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={clinic.bookingUrl} target="_blank" rel="noopener" class="btn btn-red">Randevu al</a>
          <a href={`tel:${clinic.phoneE164}`} class="btn btn-line text-navy">{clinic.phone}</a>
        </div>
      </div>
      <Image src={entry.data.hero} alt={entry.data.heroAlt} widths={[480, 720, 960]} sizes="(min-width: 768px) 45vw, 100vw" loading="eager" class="hero-photo aspect-[4/3] w-full rounded-[28px] object-cover" />
    </header>

    <div class="wrap mt-14 grid gap-14 lg:grid-cols-[1fr_20rem]">
      <div class="prose-lupus measure">
        <Content />
        <Faq items={entry.data.faq} />
      </div>

      <aside class="space-y-10 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-[22px] bg-white p-6 ring-1 ring-line">
          <h2 class="!text-xl">Bu başlık altında</h2>
          <ul class="mt-3 space-y-2 text-[1.02rem]">
            {entry.data.includes.map((i) => (
              <li class="flex gap-2"><span class="mt-[.55em] size-1.5 shrink-0 rounded-full bg-leaf" aria-hidden="true"></span>{i}</li>
            ))}
          </ul>
        </div>
        {related.length > 0 && (
          <nav aria-label="İlgili hizmetler">
            <h2 class="!text-xl">İlgili hizmetler</h2>
            <ul class="mt-3 space-y-2">
              {related.map((r) => <li><a href={`/hizmetler/${r.id}`} class="link text-navy">{r.data.title}</a></li>)}
            </ul>
          </nav>
        )}
        {posts.length > 0 && (
          <nav aria-label="İlgili yazılar">
            <h2 class="!text-xl">İlgili yazılar</h2>
            <ul class="mt-3 space-y-2">
              {posts.map((p) => <li><a href={`/blog/${p.id}`} class="link text-navy">{p.data.title}</a></li>)}
            </ul>
          </nav>
        )}
      </aside>
    </div>
  </article>

  <CtaBand title={`${entry.data.title} için randevu`} />
</Base>
